rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'hasCompletedOnboarding', 'createdAt', 'updatedAt']) 
        && data.email is string && data.email.size() <= 100
        && data.hasCompletedOnboarding is bool
        && (
          !data.keys().hasAny(['monthlyIncome']) || data.monthlyIncome is number
        )
        && (
          !data.keys().hasAny(['budgetMode']) || (data.budgetMode is string && data.budgetMode in ['50/30/20', 'CUSTOM'])
        )
        && (
          !data.keys().hasAny(['budgetLines']) || (data.budgetLines is list && data.budgetLines.size() <= 50)
        );
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['amount', 'categoryName', 'type', 'paymentMethod', 'date', 'createdAt'])
        && data.amount is number
        && data.categoryName is string && data.categoryName.size() <= 100
        && data.type is string && data.type in ['NEED', 'WANT', 'SAVING']
        && data.paymentMethod is string && data.paymentMethod in ['CASH', 'MOBILE_MONEY', 'BANK']
        && data.date is timestamp
        && data.createdAt is timestamp
        && (
          !data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 500)
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if (
        isSignedIn() 
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().keys().hasOnly(['email', 'hasCompletedOnboarding', 'monthlyIncome', 'budgetMode', 'budgetLines', 'createdAt', 'updatedAt'])
      );
      allow update: if (
        isSignedIn() 
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['hasCompletedOnboarding', 'monthlyIncome', 'budgetMode', 'budgetLines', 'updatedAt'])
      );

      match /expenses/{expenseId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if (
          isSignedIn() 
          && request.auth.uid == userId
          && isValidId(expenseId)
          && isValidExpense(incoming())
          && incoming().createdAt == request.time
          && incoming().keys().hasOnly(['amount', 'categoryName', 'type', 'paymentMethod', 'date', 'createdAt', 'notes'])
        );
        allow update: if (
          isSignedIn() 
          && request.auth.uid == userId
          && isValidExpense(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'categoryName', 'type', 'paymentMethod', 'date', 'notes'])
        );
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
